<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login wspv2</title>
  <!-- <link rel="icon" href="/esaw/vid-user-logo-defaul/zypherr(1).png"> -->
  <link rel="stylesheet" href="/public/css/login.css">
</head>

<body>
  <!-- Imagen en la parte superior -->
  <!-- <img src="/esaw/vid-user-logo-defaul/zypherr.png" alt="Logo" class="header-img"> -->

  <div class="form">
    <div class="flip-card__inner">
      <div class="flip-card__front">
        <div class="title">Iniciar sesión</div>
        <div class="flip-card__form" id="login-form">
          <input class="flip-card__input login_username" name="username" placeholder="Nombre de Usuario" type="text">
          <input class="flip-card__input login_password" name="password" placeholder="Contraseña" type="password">
          <button class="flip-card__btn" id="login_btn" type="submit">¡Vamos!</button>
        </div>
        <div class="span" id="to-register">¿No tienes cuenta? Regístrate</div>
        <!-- Enlace Olvidé mi contraseña -->
        <div class="forgot-password" id="forgot-password">¿Olvidaste tu contraseña?</div>
      </div>
      <div class="flip-card__back">
        <div class="title">Registrarse</div>
        <div class="flip-card__form" id="register-form">
          <input class="flip-card__input" name="fullname" placeholder="Nombre" type="text">
          <input class="flip-card__input" name="email" placeholder="Correo electrónico" type="email">
          <input class="flip-card__input" name="password" placeholder="Contraseña" type="password">
          <input class="flip-card__input" type="password" name="confirmpassword" id="confirm-password" placeholder="Repite tu contraseña">
          <button class="flip-card__btn" id="signin_btn" type="submit">¡Confirmar!</button>
        </div>
        <div class="span" id="to-login">¿Ya tienes cuenta? Inicia sesión</div>
      </div>
    </div>
  </div>

  <script type="module" src="/public/js/login.js"></script>

</body>

</html>